generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id              String            @id @default(uuid()) @db.Uuid
  githubId        String            @unique @db.VarChar(30)
  githubLogin     String            @db.VarChar(100)
  name            String?           @db.VarChar(200)
  email           String?           @db.VarChar(320)
  avatarUrl       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sessions        Session[]
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  createdTasks    Task[]            @relation("TaskCreator")
  assignedTasks   Task[]            @relation("TaskAssignee")
  githubConnections GitHubConnection[] @relation("GitHubConnector")
  linkedGitHubItems TaskGitHubLink[] @relation("GitHubLinkCreator")
  sentInvitations WorkspaceInvitation[] @relation("InvitationInviter")
  acceptedInvitations WorkspaceInvitation[] @relation("InvitationAcceptor")
  taskActivities TaskActivity[] @relation("TaskActivityActor")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId, expiresAt])
}

model Workspace {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @db.VarChar(100)
  slug      String            @unique @db.VarChar(50)
  ownerId   String            @db.Uuid
  owner     User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  timeZone  String            @default("UTC") @db.VarChar(100)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   WorkspaceMember[]
  tasks     Task[]
  githubConnection GitHubConnection?
  invitations WorkspaceInvitation[]
  taskActivities TaskActivity[]
}

model WorkspaceInvitation {
  id                String           @id @default(uuid()) @db.Uuid
  workspaceId       String           @db.Uuid
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviterId         String           @db.Uuid
  inviter           User             @relation("InvitationInviter", fields: [inviterId], references: [id])
  recipientGithubId String           @db.VarChar(30)
  recipientLogin    String           @db.VarChar(100)
  role              WorkspaceRole
  tokenHash         String           @unique @db.VarChar(64)
  status            InvitationStatus @default(PENDING)
  createdAt         DateTime         @default(now())
  expiresAt         DateTime
  respondedAt       DateTime?
  acceptedById      String?          @db.Uuid
  acceptedBy        User?            @relation("InvitationAcceptor", fields: [acceptedById], references: [id])

  @@index([workspaceId, createdAt])
  @@index([workspaceId, recipientGithubId, status])
}

model GitHubConnection {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @unique @db.Uuid
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installationId String   @db.VarChar(30)
  repositoryId   String   @db.VarChar(30)
  owner          String   @db.VarChar(100)
  name           String   @db.VarChar(100)
  fullName       String   @db.VarChar(201)
  description    String?
  htmlUrl        String
  defaultBranch  String   @db.VarChar(255)
  isPrivate      Boolean
  connectedById  String   @db.Uuid
  connectedBy    User     @relation("GitHubConnector", fields: [connectedById], references: [id])
  connectedAt    DateTime @default(now())
  disconnectedAt DateTime?
  syncGeneration Int      @default(0)
  lastSyncedAt   DateTime?
  lastSyncError  String?  @db.VarChar(300)
  items          GitHubItem[]
  activities     GitHubActivity[]
}

model GitHubItem {
  id           String @id @default(uuid()) @db.Uuid
  connectionId String @db.Uuid
  connection   GitHubConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  githubId     String @db.VarChar(30)
  syncGeneration Int @default(0)
  number       Int
  kind         GitHubItemKind
  title        String
  state        String @db.VarChar(30)
  htmlUrl      String
  authorLogin  String? @db.VarChar(100)
  createdAt    DateTime
  updatedAt    DateTime
  taskLinks    TaskGitHubLink[]

  @@unique([connectionId, githubId])
  @@index([connectionId, kind, updatedAt])
}

enum GitHubItemKind {
  ISSUE
  PULL_REQUEST
}

model GitHubActivity {
  id           String @id @default(uuid()) @db.Uuid
  connectionId String @db.Uuid
  connection   GitHubConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  githubId     String @db.VarChar(30)
  syncGeneration Int @default(0)
  event        String @db.VarChar(80)
  itemNumber   Int
  itemTitle    String
  itemUrl      String
  actorLogin   String? @db.VarChar(100)
  occurredAt   DateTime

  @@unique([connectionId, githubId])
  @@index([connectionId, occurredAt])
}

model WorkspaceMember {
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole
  joinedAt    DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String       @db.VarChar(160)
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @db.Date
  assigneeId  String?      @db.Uuid
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String       @db.Uuid
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  githubLinks TaskGitHubLink[]
  activities TaskActivity[]

  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, createdAt])
}

enum TaskActivityKind {
  TASK_CREATED
  TASK_UPDATED
  GITHUB_ITEM_LINKED
  GITHUB_ITEM_UNLINKED
}

model TaskActivity {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId      String @db.Uuid
  task        Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actorId     String @db.Uuid
  actor       User @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorLogin  String @db.VarChar(100)
  taskTitle   String @db.VarChar(160)
  kind        TaskActivityKind
  details     Json
  occurredAt  DateTime @default(now())

  @@index([workspaceId, occurredAt, id])
  @@index([taskId, occurredAt])
}

model TaskGitHubLink {
  id         String      @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  taskId     String      @db.Uuid
  task       Task        @relation(fields: [taskId], references: [id], onDelete: Restrict)
  itemId     String      @db.Uuid
  item       GitHubItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  linkedById String      @db.Uuid
  linkedBy   User        @relation("GitHubLinkCreator", fields: [linkedById], references: [id])
  linkedAt   DateTime    @default(now())
  unlinkedAt DateTime?

  @@unique([taskId, itemId])
  @@index([workspaceId, unlinkedAt])
}
